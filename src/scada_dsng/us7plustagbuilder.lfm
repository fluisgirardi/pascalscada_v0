object frmS7PlusTagBuilder: TfrmS7PlusTagBuilder
  Left = 320
  Height = 580
  Top = 140
  Width = 860
  BorderIcons = [biSystemMenu]
  Caption = 'S7CommPlus - Tag Builder'
  ClientHeight = 580
  ClientWidth = 860
  Constraints.MinHeight = 480
  Constraints.MinWidth = 700
  OnCreate = FormCreate
  OnDestroy = FormDestroy
    Position = poScreenCenter
  LCLVersion = '2.0.12.0'
  object pnlTop: TPanel
    Left = 0
    Height = 108
    Top = 0
    Width = 860
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 108
    ClientWidth = 860
    TabOrder = 0
    object btnBrowse: TButton
      Left = 8
      Height = 27
      Top = 8
      Width = 200
      Caption = 'Read the variables from the PLC'
      OnClick = btnBrowseClick
      TabOrder = 0
    end
    object chkSymbolicNames: TCheckBox
      Left = 216
      Height = 21
      Top = 11
      Width = 200
      Caption = 'Use the DB symbolic name'
      Checked = True
      State = cbChecked
      TabOrder = 1
    end
    object lblStatus: TLabel
      Left = 424
      Height = 17
      Top = 13
      Width = 424
      Anchors = [akTop, akLeft, akRight]
      AutoSize = False
      Caption = 'Read the variables from the PLC first.'
      ParentColor = False
    end
    object lblFilter: TLabel
      Left = 8
      Height = 17
      Top = 46
      Width = 40
      Caption = 'Filter'
      ParentColor = False
    end
    object edtFilter: TEdit
      Left = 56
      Height = 27
      Top = 42
      Width = 240
      OnChange = FilterChanged
      TabOrder = 2
    end
    object btnExpandAll: TButton
      Left = 8
      Height = 27
      Top = 75
      Width = 130
      Caption = 'Expand all'
      OnClick = btnExpandAllClick
      TabOrder = 4
    end
    object btnCollapseAll: TButton
      Left = 146
      Height = 27
      Top = 75
      Width = 130
      Caption = 'Collapse all'
      OnClick = btnCollapseAllClick
      TabOrder = 7
    end
    object chkShowSkipped: TCheckBox
      Left = 292
      Height = 21
      Top = 79
      Width = 300
      Caption = 'Show the variables that do not become a tag'
      OnChange = FilterChanged
      TabOrder = 5
    end
    object chkIncludeAreas: TCheckBox
      Left = 600
      Height = 21
      Top = 79
      Width = 250
      Anchors = [akTop, akLeft, akRight]
      Caption = 'Include the I, Q and M areas'
      TabOrder = 6
    end
  end
  object tvTags: TTreeView
    Left = 0
    Height = 340
    Top = 108
    Width = 860
    Align = alClient
    ReadOnly = True
    TabOrder = 1
    OnKeyDown = tvTagsKeyDown
    OnMouseDown = tvTagsMouseDown
    Options = [tvoAutoItemHeight, tvoHideSelection, tvoReadOnly, tvoRowSelect, tvoShowButtons, tvoShowLines, tvoShowRoot, tvoToolTips, tvoThemedDraw]
  end
  object pnlBottom: TPanel
    Left = 0
    Height = 160
    Top = 420
    Width = 860
