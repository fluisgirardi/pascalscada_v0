function DecodeB64(const S:String):TBytes;
var
  Raw:AnsiString;
  i:Integer;
begin
  Raw := DecodeStringBase64(S);
  SetLength(Result, Length(Raw));
  for i:=1 to Length(Raw) do Result[i-1] := Byte(Raw[i]);
end;

