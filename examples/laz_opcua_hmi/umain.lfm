  Position = poScreenCenter
  LCLVersion = '4.9.0.0'
  object LabelInstructions: TLabel
    Left = 8
    Height = 270
    Top = 8
    Width = 744
    Align = alTop
    AutoSize = False
    BorderSpacing.Around = 8
    Caption = 'COMO FUNCIONA'#10'Tudo nesta tela foi colocado no form em tempo de projeto: o OPCUADriver1 (TOPCUADriver), os tags (TagCounter, TagDouble, TagInt, TagBool, TagText) e os controles HMI ligados a eles pela propriedade PLCTag. Nao ha codigo de leitura nem de escrita: o driver le os tags (RefreshTime = 100 ms) e cada controle mostra e grava o valor do seu tag.'#10#10'O QUE FAZER'#10'1. Contador: so leitura, muda sozinho no servidor (Test.Counter).'#10'2. Numero real: digite um valor e tecle Enter (ou saia do campo) para gravar em Test.Double; o rotulo ao lado mostra o valor lido de volta.'#10'3. Inteiro: arraste a barra (0 a 100); a barra de progresso e o rotulo mostram o valor lido de Test.Int32.'#10'4. Booleano: marque/desmarque para gravar 1/0 em Test.Bool.'#10'5. Texto: digite e tecle Enter para gravar em Test.String.'#10'6. Desmarque "Servidor de teste local" para derrubar o servidor: os tags entram em erro; marque de novo e o driver reconecta sozinho.'#10#10'As variaveis sao ficticias: vem do servidor de teste que o programa sobe em opc.tcp://localhost:48401. Para um servidor real, mude OPCUADriver1.EndpointUrl e o LongAddress (NodeId) de cada tag.'
    ParentColor = False
    WordWrap = True
  end
